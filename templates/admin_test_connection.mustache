{{!
    @template mod_naas/admin_test_connection

    Test-connection control on the Nugget plugin administration page.

    Context variables required for this template:
    * buttonid - HTML id of the test button
    * resultid - HTML id of the result region
    * buttonlabel - Visible button label
    * testinglabel - Label shown while the request is in flight

    Example context (json):
    {
        "buttonid": "testconnection",
        "resultid": "connection-result",
        "buttonlabel": "Test connection",
        "testinglabel": "Testing…"
    }
}}
<button type="button"
        class="btn btn-secondary"
        id="{{buttonid}}"
        data-testing-label="{{testinglabel}}">
    {{buttonlabel}}
</button>
<div id="{{resultid}}"
     class="connection-result mt-2"
     role="status"
     aria-live="polite"
     hidden></div>
