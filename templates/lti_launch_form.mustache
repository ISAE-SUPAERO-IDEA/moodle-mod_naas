{{!
    @template mod_naas/lti_launch_form

    Template for generating the LTI POST automatic launch form.

    Context variables required for this template:
    * launchurl - The validated LTI launch URL
    * fields - Array containing 'name' and 'value' for each hidden form input
}}
<form id="ltiLaunchForm" name="ltiLaunchForm" method="POST" action="{{launchurl}}">
    {{#fields}}
    <input type="hidden" name="{{name}}" value="{{value}}"/>
    {{/fields}}
</form>
